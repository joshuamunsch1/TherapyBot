# Copy this file to ".env" and fill in your real values.
# ".env" is git-ignored, so your key never ends up in the repository.

# Required: your Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: model used for the simulated patient.
# claude-sonnet-5 is cheaper; claude-opus-5 is the most capable.
THERAPYBOT_MODEL=claude-sonnet-5

# Optional: password for the instructor area at /admin (default: admin)
THERAPYBOT_ADMIN_PASSWORD=change-me

# Optional: keeps instructor logins valid across server restarts.
# Any long random string.
THERAPYBOT_SECRET=

# Optional: code students must enter to start a session. Strongly recommended
# on a public URL, otherwise anyone who finds the address can spend API credit.
THERAPYBOT_ACCESS_CODE=

# Optional: maximum student messages per session (default 40, 0 = unlimited).
THERAPYBOT_MAX_MESSAGES=40

# Optional: where the SQLite database is stored (default: sessions.db next to
# app.py). On Render set this to a path on the persistent disk.
THERAPYBOT_DB_PATH=
